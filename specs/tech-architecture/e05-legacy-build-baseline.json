{
  "schema_version": 1,
  "captured_from": "v0.0.1 release baseline",
  "toolchain": "meson",
  "configuration": {
    "required_pkg_config_modules": ["glib-2.0", "gtk+-2.0"],
    "options": [
      "one-plugin-dir", "user-plugin-dir", "gtk3-proof", "opengl", "esd",
      "mikmod", "vorbis", "simd", "ipv6", "oss"
    ]
  },
  "outputs": {
    "executables": ["xmms", "wmxmms"],
    "library": "libxmms",
    "plugin_families": ["Input", "Output", "Effect", "General", "Visualization"],
    "isolated_gtk3_proof": "tests/test-gtk3-play-button-proof"
  },
  "test_contract": {
    "orchestrator": "meson test",
    "shell_contracts": [
      "tests/test-package-recipes.sh",
      "tests/test-plugin-linkage.sh",
      "tests/test-release-tools.sh",
      "tests/verify-no-autotools-artifacts.sh"
    ]
  },
  "install_contract": {
    "plugin_directory": "lib/xmms",
    "man_pages": ["xmms.1", "wmxmms.1"],
    "translations": "po"
  },
  "delivery_contract": {
    "source_distribution": "meson dist",
    "debian_build": "tools/package-deb.sh",
    "packages": ["xmms", "libxmms-dev"],
    "release_targets": ["linuxmint22.3", "ubuntu26.04"],
    "release_workflow": ".github/workflows/package-release.yml",
    "publication": "draft-only"
  }
}
